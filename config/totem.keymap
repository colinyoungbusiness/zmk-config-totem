    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        colemak_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "COLE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     G     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     D     ┃   ┃     H     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃     N     ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     K     ┃     M     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃           ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
               &kp Q       &kp W       &kp F        &kp P        &kp G            &kp J      &kp L        &kp U        &kp Y       &kp SEMI
               &mt LGUI A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp D            &kp H      &mt RSHFT N  &mt RCTRL E  &mt RALT I  &mt RGUI O
&kp BACKSLASH  &kp Z       &kp X       &kp C        &kp V        &kp B            &kp K      &kp M        &kp COMMA    &kp DOT     &kp FSLH    &kp SINGLE_QUOTE
                                       &kp ESCAPE   &lt 2 TAB    &kp BACKSPACE    &kp SPACE  &lt 3 ENTER  &kp DELETE
            >;
        };

        QWERTY_layer {
            label = "QWERT";
            bindings = <
               &kp Q           &kp W           &kp E        &kp R             &kp T            &kp Y      &kp U             &kp I        &kp O           &kp P
               &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LCTRL D  &mt LEFT_SHIFT F  &kp G            &kp H      &mt LEFT_SHIFT N  &mt RCTRL K  &mt LEFT_ALT L  &mt RIGHT_GUI SEMICOLON
&kp BACKSLASH  &kp Z           &kp X           &kp C        &kp V             &kp B            &kp N      &kp M             &kp COMMA    &kp DOT         &kp FSLH                 &kp SQT
                                               &kp ESCAPE   &lt 2 TAB         &kp BACKSPACE    &kp SPACE  &lt 3 ENTER       &kp DEL
            >;
        };

        nav_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "NAVI";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃           ┃           ┃     UP    ┃           ┃     {     ┃   ┃     }     ┃     7     ┃     8     ┃     9     ┃     +     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   SHIFT   ┃   LEFT    ┃    DOWN   ┃   RIGHT   ┃     [     ┃   ┃     ]     ┃     4     ┃     5     ┃     6     ┃     -     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃   P UP    ┃  C LOCK   ┃  P DOWN   ┃     (     ┃   ┃     )     ┃     1     ┃     2     ┃     3     ┃     *     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    TAB    ┃    SPC    ┃   ┃    DEL    ┃     0     ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
               &kp ESC    &kp HOME   &kp UP    &kp END    &kp LBRC    &kp RBRC  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS
               &kp LSHFT  &kp LEFT   &kp DOWN  &kp RIGHT  &kp LBKT    &kp RBKT  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS
&kp BACKSLASH  &kp DEL    &kp PG_UP  &kp CAPS  &kp PG_DN  &kp LPAR    &kp RPAR  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_MULTIPLY  &kp FSLH
                                     &trans    &trans     &trans      &mo 4     &kp KP_N0  &trans
            >;
        };

        sim_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "SYM";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     !     ┃     @     ┃     #     ┃     $     ┃     %     ┃   ┃     ˆ     ┃     &     ┃     Ü     ┃     '     ┃     "     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     Ä     ┃           ┃    SZ     ┃           ┃           ┃   ┃   MUTE    ┃   YEN     ┃   EURO    ┃  POUND    ┃     Ö     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃  EMAIL1   ┃  EMAIL2   ┃           ┃           ┃           ┃   ┃   VOL-    ┃   VOL+    ┃   LAST    ┃   NEXT    ┃     \     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    GIF    ┃    ADJ    ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
              &kp EXCL          &kp AT      &kp HASH           &kp DLLR         &kp PRCNT        &kp CARET             &kp AMPS              &kp ASTERISK     &kp SQT           &kp DQT
              &kp GRAVE         &kp TILDE   &kp MINUS          &kp UNDERSCORE   &kp BACKSLASH    &kp SLASH             &kp PIPE              &kp LESS_THAN    &kp GREATER_THAN  &kp COLON
&kp CAPSLOCK  &kp C_PLAY_PAUSE  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp PRINTSCREEN  &kp C_PREV        &kp C_NEXT  &kp INSERT
                                            &trans             &trans           &mo 4            &trans                &trans                &trans
            >;
        };

        adjust_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "ADJ";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃   RESET   ┃ BT CLEAR  ┃  OUT TOG  ┃           ┃           ┃   ┃           ┃    F7     ┃    F8     ┃    F9     ┃    F12    ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃ BOOTLOAD  ┃ BT NEXT   ┃           ┃           ┃           ┃   ┃           ┃    F4     ┃    F5     ┃    F6     ┃    F11    ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃ BT PREV   ┃           ┃           ┃           ┃   ┃           ┃    F1     ┃    F2     ┃    F3     ┃    F10    ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃           ┃           ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
        &sys_reset      &mkp RCLK       &mmv MOVE_UP    &mkp LCLK        &msc SCRL_UP      &msc SCRL_LEFT   &kp F7  &kp F8  &kp F9  &kp F12
        &bootloader     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN    &msc SCRL_RIGHT  &kp F4  &kp F5  &kp F6  &kp F11
&trans  &bt BT_CLR_ALL  &bt BT_CLR      &bt BT_NXT      &bt BT_PRV       &out OUT_TOG      &mkp MCLK        &kp F1  &kp F2  &kp F3  &kp F10  &trans
                                        &trans          &trans           &trans            &trans           &trans  &trans
            >;
        };

        artsey_base {
            bindings = <
        &lt 9 A    &lt 13 R   &lt 12 T   &lt 6 S    &kp TAB          &kp TAB        &lt 9 A    &lt 13 R   &lt 12 T   &lt 6 S
        &lt 7 E    &kp Y      &lt 14 I   &lt 8 O    &kp BACKSPACE    &kp BACKSPACE  &lt 7 E    &kp Y      &lt 14 I   &lt 8 O
&trans  &kp LC(C)  &kp LC(V)  &kp LC(X)  &kp SPACE  &kp LGUI         &kp RGUI       &kp SPACE  &kp LC(C)  &kp LC(V)  &kp LC(X)  &trans
                              &kp LALT   &kp LSHFT  &kp LCTRL        &kp LCTRL      &kp LSHFT  &kp RALT
            >;

            label = "ART_BASE";
        };

        artsey_num {
            bindings = <
        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans     &kp STAR     &kp STAR   &kp N1     &kp N2    &kp N3  &trans
        &kp N4        &kp N5        &kp N6        &kp PLUS   &kp FSLH     &kp FSLH   &kp N4     &kp N5    &kp N6  &kp PLUS
&kp N0  &kp N7        &kp N8        &kp N9        &kp MINUS  &kp LGUI     &kp RGUI   &kp N7     &kp N8    &kp N9  &kp MINUS  &kp N0
                                    &kp LALT      &kp LSHFT  &kp LCTRL    &kp LCTRL  &kp LSHFT  &kp RALT
            >;

            label = "ART_NUM";
        };

        artsey_punc {
            bindings = <
        &kp HASH  &kp GRAVE    &kp SEMI           &kp BSLH   &trans       &trans     &kp HASH   &kp GRAVE    &kp SEMI           &kp BSLH
        &trans    &kp AT_SIGN  &kp MINUS          &kp EQUAL  &trans       &trans     &trans     &kp AT_SIGN  &kp MINUS          &kp EQUAL
&trans  &trans    &kp COLON    &kp DOUBLE_QUOTES  &kp SQT    &kp LGUI     &kp RGUI   &trans     &kp COLON    &kp DOUBLE_QUOTES  &kp SQT    &trans
                               &kp LALT           &kp LSHFT  &kp LCTRL    &kp LCTRL  &kp LSHFT  &kp RALT
            >;

            label = "ART_PUNC";
        };

        artsey_cus {
            bindings = <
               &kp C_PLAY_PAUSE      &kp C_MUTE    &kp C_VOLUME_UP           &trans     &trans       &trans     &kp C_PLAY_PAUSE      &kp C_MUTE    &kp C_VOLUME_UP           &trans
               &kp C_PREVIOUS        &kp C_NEXT    &kp C_VOL_DN              &trans     &trans       &trans     &kp N4                &kp N5        &kp C_VOL_DN              &trans
&kp C_BRI_MIN  &kp C_BRIGHTNESS_DEC  &kp C_BRI_UP  &kp C_BRIGHTNESS_MAXIMUM  &trans     &kp LGUI     &kp RGUI   &kp C_BRIGHTNESS_DEC  &kp C_BRI_UP  &kp C_BRIGHTNESS_MAXIMUM  &trans  &kp C_BRIGHTNESS_MINIMUM
                                                   &kp LALT                  &kp LSHFT  &kp LCTRL    &kp LCTRL  &kp LSHFT             &kp RALT
            >;

            label = "ART_CUS";
        };

        artsey_sym {
            bindings = <
        &trans  &kp LEFT_PARENTHESIS   &kp LBKT  &kp LEFT_BRACE   &kp LESS_THAN       &kp LEFT_PARENTHESIS   &trans     &kp LBKT  &kp LEFT_BRACE   &kp LESS_THAN
        &trans  &kp RIGHT_PARENTHESIS  &kp RBKT  &kp RIGHT_BRACE  &kp GREATER_THAN    &kp RIGHT_PARENTHESIS  &trans     &kp RBKT  &kp RIGHT_BRACE  &kp GREATER_THAN
&trans  &trans  &trans                 &trans    &trans           &kp LGUI            &kp RGUI               &trans     &trans    &trans           &trans            &trans
                                       &kp LALT  &kp LSHFT        &kp LCTRL           &kp LCTRL              &kp LSHFT  &kp RALT
            >;

            label = "ART_SYM";
        };

        artsey_mouse {
            bindings = <
        &msc SCRL_UP    &mkp RCLK       &mmv MOVE_UP    &mkp LCLK        &msc SCRL_LEFT     &msc SCRL_LEFT   &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &msc SCRL_UP
        &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT    &msc SCRL_RIGHT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN
&trans  &mkp MCLK       &mkp MB4        &mkp MB5        &trans           &kp LGUI           &kp RGUI         &trans          &mkp MB5        &mkp MB4         &mkp MCLK       &trans
                                        &kp LALT        &kp LSHFT        &kp LCTRL          &kp LCTRL        &kp LSHFT       &kp RALT
            >;

            label = "ART_MOU";
        };

        artsey_nav {
            bindings = <
        &kp PAGE_UP    &kp HOME  &kp UP_ARROW  &kp END    &kp INSERT         &kp INS          &kp HOME        &kp UP_ARROW  &kp END    &kp PAGE_UP
        &kp PAGE_DOWN  &kp LEFT  &kp DOWN      &kp RIGHT  &kp PRINTSCREEN    &kp PRINTSCREEN  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &kp PAGE_DOWN
&trans  &trans         &trans    &trans        &trans     &kp LGUI           &kp RGUI         &trans          &trans        &trans     &trans         &trans
                                 &kp LALT      &kp LSHFT  &kp LCTRL          &kp LCTRL        &kp LSHFT       &kp RALT
            >;

            label = "ART_NAV";
        };

        artsey_macro {
            label = "ART_MACRO";
            bindings = <
        &kp LC(LS(TAB))  &kp LC(TAB)  &trans     &kp LA(TAB)   &kp TAB          &kp TAB        &kp LS(LC(TAB))  &kp LC(TAB)  &trans     &kp LA(TAB)
        &kp LC(C)        &kp LC(V)    &kp LC(X)  &kp LEFT_GUI  &kp LC(LA(E))    &kp LC(LA(E))  &kp LC(C)        &kp LC(V)    &kp LC(X)  &kp RIGHT_GUI
&trans  &trans           &trans       &trans     &trans        &kp LGUI         &kp RGUI       &trans           &trans       &trans     &trans         &trans
                                      &kp LALT   &kp LSHFT     &kp LCTRL        &kp LCTRL      &kp LSHFT        &kp RALT
            >;
        };

        artsey_hold {
            label = "ART_HOLD";
            bindings = <
        &kp F1  &trans  &kp LSHFT     &kp LCTRL     &kp SPACE    &kp SPACE  &kp F1     &trans    &kp LEFT_SHIFT  &kp RCTRL
        &kp F3  &kp F4  &kp LEFT_GUI  &kp LEFT_ALT  &trans       &trans     &kp F3     &kp F4    &kp LEFT_GUI    &kp LEFT_ALT
&kp F2  &kp F5  &kp F6  &kp F7        &kp F8        &kp LGUI     &kp RGUI   &kp F5     &kp F6    &kp F7          &kp F8        &kp F2
                        &kp LALT      &kp LSHFT     &kp LCTRL    &kp LCTRL  &kp LSHFT  &kp RALT
            >;
        };

        artsey_gui {
            label = "ART_GUI";
            bindings = <
        &kp LC(LG(LEFT_ARROW))  &kp LG(LC(RIGHT))  &trans    &kp LG(UP_ARROW)    &trans       &trans     &kp LC(LG(LEFT_ARROW))  &kp LC(LG(RIGHT))  &trans   &kp LG(UP_ARROW)
        &kp LG(LEFT_ARROW)      &kp LG(RIGHT)      &trans    &kp LG(DOWN_ARROW)  &trans       &trans     &kp LG(LEFT_ARROW)      &kp LG(RIGHT)      &trans   &kp LG(DOWN)
&kp F9  &kp F10                 &kp F11            &kp F12   &kp F13             &kp LGUI     &kp RGUI   &kp F9                  &kp F10            &kp F11  &kp F12           &kp F13
                                                   &kp LALT  &kp LSHFT           &kp LCTRL    &kp LCTRL  &kp LSHFT               &kp RALT
            >;
        };
    };
};
